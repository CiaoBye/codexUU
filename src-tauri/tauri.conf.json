{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexUU",
  "version": "1.3.21",
  "identifier": "com.ciaobye.codexuu",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodexUU",
        "width": 1200,
        "height": 760,
        "minWidth": 1060,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "focus": true,
        "decorations": false,
        "shadow": true,
        "zoomHotkeysEnabled": false,
        "dataDirectory": "CodexUU-webview-main"
      },
      {
        "label": "widget",
        "title": "CodexUU Widget",
        "url": "/#widget",
        "width": 260,
        "height": 130,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "dataDirectory": "CodexUU-webview-widget"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset:; font-src 'self' data:;"
    }
  },
  "plugins": {}
}
